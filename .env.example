# Copy to .env and fill in. .env is gitignored. NEVER paste these into chat, logs or the agent.

# Groww Trading API — fill ONE of the two options.
# Option A (simplest): access token generated on the Groww Cloud API Keys page. Expires daily — replace each morning.
GROWW_ACCESS_TOKEN=

# Option B: approval key + secret (approve the key daily on the Groww page; the app fetches the token).
GROWW_API_KEY=
GROWW_API_SECRET=

# Live order placement is refused unless this is exactly I_UNDERSTAND (plus stage/mode + gate record).
TRADING_LIVE_ENABLED=

# Claude API key for the agent layer (Phase 5+)
ANTHROPIC_API_KEY=
