# secrets — never commit (L1: any *.env, e.g. runtime.env, not just .env)
.env
.env.*
*.env
*.env.*
!.env.example

# runtime state, data, logs — anchored to the repo root ("/") so that source packages such as
# src/tradingagent/data/ are NOT ignored
/runtime/
/data/
/journal/events/
/agent_workdir/charts/

# Claude Code local permissions (machine-specific; agents/skills under .claude/ are still committed)
/.claude/settings.json
/.claude/settings.local.json

# python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.coverage
htmlcov/
